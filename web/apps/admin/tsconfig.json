{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "paths": {
      "@openforms/sdk": ["../../packages/sdk/src/index.ts"],
      "@openforms/react": ["../../packages/react/src/index.ts"],
      "@schemas/*": ["../../../schemas/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
